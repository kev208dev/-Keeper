# 배포 환경 설정 예시. 실제 값을 이 파일에 적어 커밋하지 않는다.
# Dockerfile에 아래 값이 기본으로 들어 있으므로, 보통은 PORT만 호스팅 서비스가 정해 준다.

# production이면 API 문서를 끄고 보안 헤더를 추가한다
KEEPER_ENV=production

# DB 파일 위치. 서버를 재시작해도 지워지지 않는 영구 저장소를 가리켜야 한다
KEEPER_DB_PATH=/data/keeper.db

# 빌드된 앱 화면 폴더
KEEPER_STATIC_DIR=/app/static

# 서버가 사용할 포트
PORT=8000

# 프록시 뒤에서 실제 접속 IP를 읽을 때 믿을 프록시 주소. 서버를 인터넷에 직접 노출하면 *를 쓰면 안 된다
FORWARDED_ALLOW_IPS=*
